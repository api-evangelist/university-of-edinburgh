{
  "opencollection": "1.0.0",
  "info": {
    "name": "Edinburgh DataShare REST Bitstreams Items API",
    "version": "6.x"
  },
  "items": [
    {
      "info": {
        "name": "Items",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://datashare.ed.ac.uk/rest/items",
            "params": [
              {
                "name": "expand",
                "value": "metadata,bitstreams",
                "type": "query",
                "description": "Comma-separated list of optional fields to expand in the response (e.g. metadata, bitstreams, collections, parentCommunity, all)."
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Maximum number of records to return."
              },
              {
                "name": "offset",
                "value": "",
                "type": "query",
                "description": "Offset into the result set for pagination."
              }
            ]
          },
          "docs": "Return a list of items."
        },
        {
          "info": {
            "name": "Get item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://datashare.ed.ac.uk/rest/items/:itemId",
            "params": [
              {
                "name": "itemId",
                "value": "",
                "type": "path",
                "description": "UUID of the item."
              },
              {
                "name": "expand",
                "value": "metadata,bitstreams",
                "type": "query",
                "description": "Comma-separated list of optional fields to expand in the response (e.g. metadata, bitstreams, collections, parentCommunity, all)."
              }
            ]
          },
          "docs": "Return the specified item."
        },
        {
          "info": {
            "name": "Get item metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://datashare.ed.ac.uk/rest/items/:itemId/metadata",
            "params": [
              {
                "name": "itemId",
                "value": "",
                "type": "path",
                "description": "UUID of the item."
              }
            ]
          },
          "docs": "Return metadata of the specified item."
        },
        {
          "info": {
            "name": "Get item bitstreams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://datashare.ed.ac.uk/rest/items/:itemId/bitstreams",
            "params": [
              {
                "name": "itemId",
                "value": "",
                "type": "path",
                "description": "UUID of the item."
              },
              {
                "name": "expand",
                "value": "metadata,bitstreams",
                "type": "query",
                "description": "Comma-separated list of optional fields to expand in the response (e.g. metadata, bitstreams, collections, parentCommunity, all)."
              }
            ]
          },
          "docs": "Return bitstreams of the specified item."
        }
      ]
    }
  ],
  "bundled": true
}